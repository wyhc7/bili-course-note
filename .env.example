# ============ 复制为 .env 后填写 ============

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000

# ---- B站下载 ----
# 部分大会员/高清视频需要 Cookie。从浏览器登录 B站后，F12 → Network → 任一请求头里复制整个 Cookie 值。
# 格式: SESSDATA=xxx; bili_jct=yyy; buvid3=zzz
# 留空则匿名下载（一般 720p 以内够用）
BILI_COOKIE=
# 下载清晰度上限，低配机建议 480 或 720（越小越快、越省磁盘）
MAX_HEIGHT=720

# ---- 转写（本地 Whisper）----
# 2核4G 强烈建议 base + int8。想更准换 small（更慢、更吃内存）
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANG=zh
# 每段秒数（防 OOM 关键，别调太大）
WHISPER_CHUNK_SEC=300
WHISPER_CPU_THREADS=2
# local=本地转写（默认）| cloud=云端转写（后面不想硬扛可切）
TRANSCRIBE_PROVIDER=local
# 若切 cloud，填这些：
# CLOUD_ASR_BASE_URL=https://api.openai.com/v1
# CLOUD_ASR_API_KEY=
# CLOUD_ASR_MODEL=whisper-1

# ---- 抽帧 / 视觉理解 ----
# 等间隔抽帧间隔（秒）。10s + 感知哈希去重，翻页抓得住、候选也不爆炸
DENSE_FRAME_INTERVAL_SEC=10
# 感知哈希去重阈值：相邻两帧汉明距离 <= 该值视为同一画面（0=关闭）
FRAME_DEDUPE_DISTANCE=6
# 目标截图密度（秒/张，给 LLM 的数量下限）：120=每2分钟至少一张
SCREENSHOT_EVERY_SEC=120
# 相邻截图最小间隔（秒）与单篇上限，防同页重复与刷屏
SCREENSHOT_MIN_GAP_SEC=8
MAX_SCREENSHOTS=40
# 标记时间点吸附容差：落在这附近的候选帧直接复用，不二次截帧
SNAP_TOLERANCE_SEC=20
# 最终插图宽度（px），0=原片分辨率
SHOT_WIDTH=1280
# 视觉理解开关（需多模态 key）。true 才会调视觉 API，占云端费用，不占本地算力
VISION_ENABLED=false
VISION_MODEL=qwen-vl-max
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
# 候选帧预算：每分钟取几帧（下限 VISION_MAX_FRAMES，硬上限 VISION_MAX_FRAMES_CAP）
VISION_MAX_FRAMES=36
VISION_FRAMES_PER_MIN=3
VISION_MAX_FRAMES_CAP=240
# 网格拼图：3x3 一格，单格分辨率（太小读不出公式下标）
VISION_USE_GRID=true
VISION_GRID_COLS=3
VISION_GRID_ROWS=3
VISION_CELL_W=768
VISION_CELL_H=432
# 视觉调用重试（总尝试次数 / 退避基数），网络抖动不至于整格候选报废
VISION_RETRY_ATTEMPTS=3
VISION_RETRY_BACKOFF_SEC=2

# ---- LLM 总结 ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_CHARS=48000
# 单次输出上限（token）。实际取 min(本值, 按输入体量估算)，防止长课笔记被截断
LLM_MAX_OUTPUT_TOKENS=8000
NOTE_STYLE=网课

# ---- 磁盘清理 ----
# 任务完成后是否删除下载的视频/音频（保留 md 笔记和截图）。强烈建议 true，否则磁盘会爆
CLEANUP_AFTER_DONE=true
# true=整个帧目录全留（体积大）；false=只留笔记里真正引用的截图，候选帧/网格图删掉。
# 默认 false 也不会让截图 404，不需要为了看图改成 true
KEEP_FRAMES=false

# ============ 复制为 .env 后填写 ============

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000

# ---- B站下载 ----
# 部分大会员/高清视频需要 Cookie。从浏览器登录 B站后，F12 → Network → 任一请求头里复制整个 Cookie 值。
# 格式: SESSDATA=xxx; bili_jct=yyy; buvid3=zzz
# 留空则匿名下载（一般 720p 以内够用）
BILI_COOKIE=
# 下载清晰度上限，低配机建议 480 或 720（越小越快、越省磁盘）
MAX_HEIGHT=720

# ---- 转写（本地 Whisper）----
# 2核4G 强烈建议 base + int8。想更准换 small（更慢、更吃内存）
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANG=zh
# 每段秒数（防 OOM 关键，别调太大）
WHISPER_CHUNK_SEC=300
WHISPER_CPU_THREADS=2
# local=本地转写（默认）| cloud=云端转写（后面不想硬扛可切）
TRANSCRIBE_PROVIDER=local
# 若切 cloud，填这些：
# CLOUD_ASR_BASE_URL=https://api.openai.com/v1
# CLOUD_ASR_API_KEY=
# CLOUD_ASR_MODEL=whisper-1

# ---- 抽帧 / 视觉理解 ----
FRAME_INTERVAL_SEC=60
# 视觉理解开关（需多模态 key）。true 才会调视觉 API，占云端费用，不占本地算力
VISION_ENABLED=false
VISION_MODEL=qwen-vl-max
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MAX_FRAMES=12

# ---- LLM 总结 ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_CHARS=48000
NOTE_STYLE=网课

# ---- 磁盘清理 ----
# 任务完成后是否删除下载的视频/音频（保留 md 笔记和关键帧）。强烈建议 true，否则磁盘会爆
CLEANUP_AFTER_DONE=true
# 关键帧是否保留（false 则连帧一起删，更省空间）
KEEP_FRAMES=false
